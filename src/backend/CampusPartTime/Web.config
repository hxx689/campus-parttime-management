<?xml version="1.0" encoding="utf-8"?>
<!--
  校园兼职招聘管理系统 Web 配置文件
  学号：241240048  姓名：黄潇萱
  说明：
    1. 连接字符串使用最小权限数据库账号 cp_app_user，不得使用实例管理员账号；
       口令以占位符 __DB_PASSWORD__ 表示，部署时替换后立即执行配置节加密，见《运行说明.txt》第 3 节。
    2. 认证采用 Forms 认证，未登录用户一律跳转 Login.aspx；
       页面级角色校验在 Common/PageBase.cs 的 OnInit 中完成，二者共同构成访问控制。
    3. 上传目录 Uploads 仅允许图片扩展名，单文件不超过 2MB。
-->
<configuration>
  <connectionStrings>
    <!-- 部署步骤：先替换 __DB_PASSWORD__ 为实施时设定的 16 位以上强口令，再执行
         aspnet_regiis -pef "connectionStrings" "站点物理路径" 加密本节点 -->
    <add name="CampusConn"
         connectionString="Data Source=.;Initial Catalog=CampusPartTime;User ID=cp_app_user;Password=__DB_PASSWORD__;MultipleActiveResultSets=True;Application Name=CampusPartTime"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="UploadImageExtensions" value=".jpg,.jpeg,.png" />
    <add key="UploadMaxSizeKB" value="2048" />
    <add key="UploadFolder" value="~/Uploads/" />
    <add key="PageSize" value="10" />
    <add key="BCryptWorkFactor" value="10" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="4096" requestValidationMode="2.0" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/JobList.aspx" timeout="60" slidingExpiration="true" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <sessionState mode="InProc" timeout="60" />
    <customErrors mode="Off" />
    <pages validateRequest="true" enableEventValidation="true" viewStateEncryptionMode="Auto" />
  </system.web>

  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="StudentRegister.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="EmployerRegister.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Styles">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Login.aspx" />
      </files>
    </defaultDocument>
    <httpErrors errorMode="Detailed" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
